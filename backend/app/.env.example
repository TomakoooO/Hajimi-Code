# API Key (required)
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
MODEL_ID=deepseek-chat

# === Sandbox Runner Configuration (2.9) ===

# Sandbox mode: "local" (default) | "container" (stub)
# HAJIMI_SANDBOX_MODE=local

# Restricted user for process-level sandbox (Phase 2)
# On Windows: a local user account name (e.g. "sandbox" or "DOMAIN\sandbox")
# On POSIX: a system user name (e.g. "nobody")
# Leave empty to run as the current process user.
# HAJIMI_SANDBOX_USER=

# Docker image for container mode (Phase 3 stub)
# HAJIMI_SANDBOX_IMAGE=python:3.12-slim

# Network policy (Phase 3, reserved)
# Comma-separated allow/deny host lists; enforce=1 to actively block.
# HAJIMI_NETWORK_ALLOW=
# HAJIMI_NETWORK_DENY=
# HAJIMI_NETWORK_ENFORCE=0
